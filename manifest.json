{
  "manifest_version": 3,
  "name": "企业信息自动查询截图",
  "version": "1.1.0",
  "description": "从 Excel 读取企业名称，自动在公示系统 / 企查查 / 爱企查查询并截取企业详情整页。",
  "minimum_chrome_version": "116",
  "permissions": [
    "tabs",
    "scripting",
    "storage",
    "downloads",
    "debugger",
    "sidePanel"
  ],
  "host_permissions": [
    "https://www.gsxt.gov.cn/*",
    "https://*.qcc.com/*",
    "https://aiqicha.baidu.com/*"
  ],
  "background": {
    "service_worker": "background/sw.js"
  },
  "side_panel": {
    "default_path": "sidepanel/panel.html"
  },
  "action": {
    "default_title": "打开企业信息自动查询截图面板"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.gsxt.gov.cn/*",
        "https://*.qcc.com/*",
        "https://aiqicha.baidu.com/*"
      ],
      "js": [
        "content/sites.js",
        "content/content.js"
      ],
      "css": [
        "content/content.css"
      ],
      "run_at": "document_idle",
      "all_frames": false
    }
  ]
}
